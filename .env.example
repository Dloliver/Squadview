# Keep test placements visible until a live provider is approved.
VITE_ADS_ENABLED=true
VITE_ADS_TEST_MODE=true
VITE_DISPLAY_ADS_ENABLED=false

# Public browser key for YouTube Data API v3.
# Restrict this key in Google Cloud by HTTP referrer and API before use.
VITE_YOUTUBE_DATA_API_KEY=

# SquadView supplied loading ads
# Production: paste the HilltopAds VAST/IMA invocation URL here locally only.
# Do not commit a live publisher tag to Git.
VITE_HILLTOPADS_VAST_URL=
VITE_LOADING_AD_COOLDOWN_MINUTES=20
